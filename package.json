{
  "name": "medusa-pos",
  "version": "0.8.0",
  "private": false,
  "author": "Nari Solutions",
  "license": "Apache-2.0",
  "homepage": "https://pos.nari.ge",
  "repository": {
    "type": "git",
    "url": "https://github.com/narisolutions/medusa-pos.git"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:staging": "vite --mode staging",
    "dev:production": "vite --mode production",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:ui": "node scripts/check-ui-rules.mjs",
    "build": "tsc && vite build",
    "build:staging": "tsc && vite build --mode staging",
    "build:production": "tsc && vite build --mode production",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev -- --features devtools",
    "tauri:build": "tauri build",
    "tauri:build:debug": "RUST_LOG=debug tauri build --debug",
    "android:build:apk": "tauri android build --apk",
    "android:build:apk:debug": "tauri android build --apk -d",
    "android:build:apk:split": "tauri android build --apk --split-per-abi",
    "android:build:apk:arm64": "tauri android build --apk --target aarch64",
    "test:env:up": "docker compose -f integration-tests/docker-compose.yml --env-file integration-tests/.env up --build -d --wait",
    "test:env:down": "docker compose -f integration-tests/docker-compose.yml down",
    "test:env:reset": "docker compose -f integration-tests/docker-compose.yml down -v",
    "test:env:logs": "docker compose -f integration-tests/docker-compose.yml logs -f medusa",
    "test:env:demo": "docker compose -f integration-tests/docker-compose.yml --env-file integration-tests/.env exec medusa npx medusa exec src/scripts/seed-demo.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@medusajs/js-sdk": "^2.21.1",
    "@medusajs/types": "^2.21.1",
    "@narisolutions/pos-toolkit": "github:narisolutions/pos-toolkit#d9c78da85b83065ec3a8baa48f1e734afbc3190c",
    "@radix-ui/react-checkbox": "^1.3.12",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-separator": "^1.1.16",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.3.8",
    "@radix-ui/react-tabs": "^1.1.22",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^8.21.3",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-http": "^2.8.3",
    "@tauri-apps/plugin-log": "^2.10.1",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-store": "^2.5.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "i18next": "^26.4.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.49.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.85.0",
    "react-i18next": "^17.0.16",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.1"
  },
  "resolutions": {
    "vitest/vite": "8.1.5"
  }
}
